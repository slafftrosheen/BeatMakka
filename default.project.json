{
  "name": "FrequencyZero",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": { "StreamingEnabled": true }
    },
    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      "AssetLibrary": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },
    "ReplicatedStorage": {
      "AppearanceLibrary": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "UiImageLibrary": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$properties": { "ScreenOrientation": "Sensor" }
    }
  }
}
