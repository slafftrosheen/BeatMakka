+++ b/src/client/QuayExperiencePanel.luau
@@ -0,0 +1,421 @@
+local Shared = game:GetService("ReplicatedStorage").Shared
+local Activities = require(Shared.QuayActivities)
+local Wardrobe = require(Shared.WardrobeCatalog)
+local Theme = require(Shared.Theme)
+local Gui = require(script.Parent.GuiFactory)
+local WardrobePreview = require(script.Parent.QuayWardrobePreview)
+local Panel = {}
+Panel.__index = Panel
+
+local function stack(parent, name, order)
+    local frame = Gui.make("Frame", parent, {
+        Name = name,
+        BackgroundTransparency = 1,
+        Size = UDim2.new(1, -10, 0, 0),
+        AutomaticSize = Enum.AutomaticSize.Y,
+        LayoutOrder = order or 3,
+    })
+    Gui.make(
+        "UIListLayout",
+        frame,
+        { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }
+    )
+    return frame
+end
+
+local function label(parent, text, order, size, color)
+    local object = Gui.label(parent, text, size or 15, color)
+    object.Size, object.AutomaticSize = UDim2.new(1, -8, 0, 0), Enum.AutomaticSize.Y
+    object.LayoutOrder = order
+    return object
+end
+
+local function button(parent, text, callback, order)
+    local object = Gui.button(parent, text, callback)
+    object.Size, object.LayoutOrder = UDim2.new(1, 0, 0, 44), order
+    return object
+end
+
+local function row(parent, order)
+    return Gui.make("Frame", parent, {
+        BackgroundTransparency = 1,
+        Size = UDim2.new(1, 0, 0, 44),
+        LayoutOrder = order,
+    })
+end
+
+local function rowButton(parent, text, callback, index, count)
+    local object = Gui.button(parent, text, callback)
+    object.Position = UDim2.fromScale((index - 1) / count, 0)
+    object.Size = UDim2.new(1 / count, -5, 1, 0)
+    return object
+end
+
+local function enable(object, enabled)
+    object.Active, object.Selectable, object.AutoButtonColor = enabled, enabled, enabled
+    object.BackgroundColor3 = if enabled then Theme.Teal else Theme.FadedTeal
+end
+
+function Panel.new(parent, send)
+    local self = setmetatable({
+        send = send,
+        motif = "waves",
+        palette = "teal",
+        slot = "head",
+        sleeveEdited = false,
+        cards = {},
+        memoryCards = {},
+        itemCards = {},
+    }, Panel)
+    self.explore = stack(parent, "NeighbourhoodActivities")
+    label(self.explore, "Take a detour", 0, 21).Font = Theme.Bold
+    label(
+        self.explore,
+        "Four optional things to try around the quay. Explore at your own pace; your next story step will wait.",
+        1
+    )
+    for index, id in Activities.Order do
+        local activity = Activities.ById[id]
+        local card = stack(self.explore, id, index + 1)
+        local heading = label(card, activity.title, 0, 18)
+        heading.Font = Theme.Bold
+        label(card, activity.kind .. "  /  " .. activity.location, 1, 13, Theme.Teal)
+        label(card, activity.description, 2)
+        local status = label(card, "", 3, 14, Theme.Teal)
+        self.cards[id] = { root = card, heading = heading, status = status }
+        if id == "memory_walk" then
+            for memoryIndex, memory in Activities.Memories do
+                local memoryCard = stack(card, memory.id, memoryIndex + 4)
+                local text = label(memoryCard, "", 0)
+                local read = button(memoryCard, "Read " .. memory.title, function()
+                    send("LifeMemory", memory.id)
+                end, 1)
+                self.memoryCards[memory.id] = { text = text, read = read }
+            end
+        elseif id == "sound_safari" then
+            self.soundProgress = label(card, "", 4)
+        elseif id == "pattern_bench" then
+            self.puzzleStart = button(card, "Sit at Ivo's pattern bench", function()
+                send("LifeStartPuzzle")
+            end, 4)
+            self.puzzle = stack(card, "PatternPuzzle", 5)
+            self.puzzleText = label(self.puzzle, "", 0, 18)
+            local answers = row(self.puzzle, 1)
+            for answerIndex, answer in { "Bolt", "Coil", "Lamp" } do
+                rowButton(answers, answer, function()
+                    send("LifeAnswer", answer)
+                end, answerIndex, 3)
+            end
+            button(self.puzzle, "Ask Ivo for a hint", function()
+                send("LifePuzzleHint")
+            end, 2)
+            self.puzzleHint = label(self.puzzle, "", 3)
+        elseif id == "sleeve_studio" then
+            self.sleevePreview = Gui.make("Frame", card, {
+                Name = "YourRecordSleeve",
+                Size = UDim2.new(1, 0, 0, 155),
+                BackgroundColor3 = Theme.Teal,
+                BorderSizePixel = 0,
+                LayoutOrder = 4,
+            })
+            Gui.round(self.sleevePreview, 8)
+            local disc = Gui.make("Frame", self.sleevePreview, {
+                Name = "Record",
+                Size = UDim2.fromOffset(110, 110),
+                Position = UDim2.new(1, -125, 0, 20),
+                BackgroundColor3 = Theme.Ink,
+                BorderSizePixel = 0,
+            })
+            Gui.round(disc, 55)
+            local centre = Gui.make("Frame", disc, {
+                Size = UDim2.fromOffset(34, 34),
+                Position = UDim2.fromOffset(38, 38),
+                BackgroundColor3 = Theme.Cream,
+                BorderSizePixel = 0,
+            })
+            Gui.round(centre, 17)
+            self.sleeveText = Gui.label(self.sleevePreview, "", 20, Theme.Cream)
+            self.sleeveText.Position = UDim2.fromOffset(14, 10)
+            self.sleeveText.Size = UDim2.new(1, -145, 0, 75)
+            self.sleeveText.Font = Theme.Bold
+            self.motifArt = Gui.make("Frame", self.sleevePreview, {
+                BackgroundTransparency = 1,
+                Position = UDim2.fromOffset(14, 90),
+                Size = UDim2.new(1, -155, 0, 45),
+            })
+            local motifs, palettes = row(card, 5), row(card, 6)
+            self.motifButtons, self.paletteButtons = {}, {}
+            for optionIndex, option in Activities.Motifs do
+                self.motifButtons[option.id] = rowButton(motifs, option.glyph, function()
+                    self.motif, self.sleeveEdited = option.id, true
+                    self:renderSleeve()
+                end, optionIndex, 3)
+            end
+            for optionIndex, option in Activities.Palettes do
+                self.paletteButtons[option.id] = rowButton(palettes, option.label, function()
+                    self.palette, self.sleeveEdited = option.id, true
+                    self:renderSleeve()
+                end, optionIndex, 3)
+            end
+            self.sleeveSave = button(card, "Print and keep this sleeve", function()
+                send("LifeSleeve", self.motif, self.palette)
+            end, 7)
+        end
+    end
+
+    self.style = stack(parent, "GrooveboxerIdentity")
+    self.rank = label(self.style, "Your groove", 0, 22)
+    self.rank.Font = Theme.Bold
+    self.tracks = label(self.style, "", 1, 16)
+    label(
+        self.style,
+        "Grow by making music, listening and helping. New discoveries count once. Your clothes never change how your music is judged.",
+        2,
+        14
+    )
+    self.titles = stack(self.style, "Titles", 3)
+    label(self.titles, "Choose your title", 0, 18).Font = Theme.Bold
+    self.titleButtons = {}
+    self.wardrobe = stack(self.style, "Wardrobe", 4)
+    label(self.wardrobe, "Your wardrobe", 0, 19).Font = Theme.Bold
+    label(
+        self.wardrobe,
+        "Add BeatMakka accessories to your own Roblox avatar. Choose a piece to wear it; use Remove to take it off.",
+        1,
+        14
+    )
+    self.preview = WardrobePreview.new(self.wardrobe)
+    self.preview.root.LayoutOrder = 2
+    local slots = row(self.wardrobe, 3)
+    self.slotButtons = {}
+    for index, slot in Wardrobe.Slots do
+        self.slotButtons[slot] = rowButton(slots, Wardrobe.SlotLabels[slot], function()
+            self.slot = slot
+            self:renderItems()
+        end, index, #Wardrobe.Slots)
+    end
+    self.items = stack(self.wardrobe, "Items", 4)
+    for index, id in Wardrobe.Order do
+        local item = Wardrobe.Items[id]
+        local card = stack(self.items, id, index)
+        local heading = label(card, item.label, 0, 17)
+        heading.Font = Theme.Bold
+        local detail = label(card, "", 1, 14)
+        local wear = button(card, "Wear", function()
+            if self.state and self.state.identity.equipped[item.slot] == id then
+                send("LifeClear", item.slot)
+            else
+                send("LifeEquip", id)
+            end
+        end, 2)
+        self.itemCards[id] = { root = card, heading = heading, detail = detail, wear = wear }
+    end
+    self.looks = stack(self.style, "SavedLooks", 5)
+    label(self.looks, "Three looks to keep", 0, 18).Font = Theme.Bold
+    self.lookButtons = {}
+    for index = 1, Wardrobe.OutfitCapacity do
+        local buttons = row(self.looks, index)
+        local save = rowButton(buttons, "Save look " .. index, function()
+            send("LifeSaveLook", index)
+        end, 1, 2)
+        local load = rowButton(buttons, "Wear look " .. index, function()
+            send("LifeLoadLook", index)
+        end, 2, 2)
+        self.lookButtons[index] = { save = save, load = load }
+    end
+    button(self.style, "Remove all BeatMakka accessories", function()
+        send("LifeResetLook")
+    end, 6)
+    self:renderSleeve()
+    return self
+end
+
+function Panel:renderSleeve()
+    local drawing = self.motif .. ":" .. self.palette
+    if self.sleeveDrawn == drawing then
+        return
+    end
+    self.sleeveDrawn = drawing
+    local color = ({ teal = Theme.Teal, coral = Theme.Coral, amber = Theme.Amber })[self.palette]
+    self.sleevePreview.BackgroundColor3 = color
+    self.sleeveText.Text = "MY QUAY\n" .. string.upper(self.motif)
+    self.sleeveText.TextColor3 = if self.palette == "amber" then Theme.Ink else Theme.Cream
+    for _, child in self.motifArt:GetChildren() do
+        child:Destroy()
+    end
+    if self.motif == "lantern" then
+        Gui.round(
+            Gui.make("Frame", self.motifArt, {
+                Size = UDim2.fromOffset(24, 34),
+                Position = UDim2.fromOffset(8, 4),
+                BackgroundColor3 = Theme.Cream,
+                BorderSizePixel = 0,
+            }),
+            7
+        )
+        Gui.make("Frame", self.motifArt, {
+            Size = UDim2.fromOffset(38, 5),
+            Position = UDim2.fromOffset(1, 0),
+            BackgroundColor3 = Theme.Ink,
+            BorderSizePixel = 0,
+        })
+    else
+        for index = 1, 8 do
+            local height = if self.motif == "steps" then (if index % 2 == 0 then 16 else 32) else 6
+            Gui.round(
+                Gui.make("Frame", self.motifArt, {
+                    Size = UDim2.new(0.1, 0, 0, height),
+                    Position = UDim2.new(
+                        (index - 1) / 8,
+                        0,
+                        0,
+                        if self.motif == "waves" then 12 + (index % 3) * 6 else 38 - height
+                    ),
+                    BackgroundColor3 = Theme.Cream,
+                    BorderSizePixel = 0,
+                }),
+                3
+            )
+        end
+    end
+    for id, control in self.motifButtons do
+        control.BackgroundColor3 = if id == self.motif then Theme.Ink else Theme.Teal
+    end
+    for id, control in self.paletteButtons do
+        control.BackgroundColor3 = if id == self.palette then Theme.Ink else Theme.Teal
+    end
+end
+
+function Panel:renderItems()
+    if not self.state then
+        return
+    end
+    for id, control in self.slotButtons do
+        control.BackgroundColor3 = if id == self.slot then Theme.Ink else Theme.Teal
+    end
+    for _, item in self.state.identity.items do
+        local card = self.itemCards[item.id]
+        card.root.Visible = item.slot == self.slot
+        card.heading.Text = item.label .. (if item.equipped then "  /  Wearing" else "")
+        card.detail.Text = item.description
+            .. "\n"
+            .. (if item.owned then "In your wardrobe" else item.unlockHint)
+        card.wear.Text = if item.equipped
+            then "Remove"
+            elseif item.owned then "Wear"
+            elseif item.source == "premium" then "See the Shop tab"
+            else "Earn through play"
+        enable(card.wear, item.owned)
+    end
+end
+
+function Panel:update(fullState, tab, journalVisible)
+    local state = fullState and fullState.experience
+    self.explore.Visible = state ~= nil and tab == "explore"
+    self.style.Visible = state ~= nil and tab == "style"
+    self.preview:setVisible(state ~= nil and tab == "style" and journalVisible == true)
+    if not state then
+        return
+    end
+    self.state = state
+    for id, card in self.cards do
+        local activity = state.activities[id]
+        card.status.Text = (
+            if activity.completed then "Keepsake earned  /  " else "First completion  /  "
+        ) .. Activities.ById[id].reward
+    end
+    for _, memory in state.memories do
+        local card = self.memoryCards[memory.id]
+        card.text.Text = memory.title .. "\n" .. (memory.text or "A little story is waiting here.")
+        card.read.Text = if memory.collected and not memory.nearby
+            then "Visit to hear this story again"
+            elseif memory.collected then "Read again"
+            elseif memory.nearby then "Read this postcard"
+            else "Find this postcard on your walk"
+        enable(card.read, memory.nearby)
+    end
+    local sounds = {}
+    for index, id in { "I01", "I02", "I03" } do
+        table.insert(
+            sounds,
+            (if fullState.unlocked[id] then "Collected  /  " else "Still to find  /  ")
+                .. ({ "Quay metal", "Vent thump", "Helper chirp" })[index]
+        )
+    end
+    self.soundProgress.Text = table.concat(sounds, "\n")
+    local bench = state.activities.pattern_bench
+    enable(self.puzzleStart, bench.nearby)
+    self.puzzleStart.Text = if not bench.nearby
+        then "Visit Morrow Repairs to play"
+        elseif state.puzzle then "Start three new patterns"
+        elseif bench.completed then "Practise three new patterns"
+        else "Sit at Ivo's pattern bench"
+    self.puzzle.Visible = state.puzzle ~= nil
+    if state.puzzle then
+        self.puzzleText.Text = "Pattern "
+            .. state.puzzle.round
+            .. " of 3\n"
+            .. table.concat(state.puzzle.tiles, "  /  ")
+            .. "  /  ?"
+        self.puzzleHint.Text = state.puzzle.hint or "There is no timer. What comes next?"
+    end
+    if not self.sleeveEdited then
+        self.motif, self.palette = state.progress.sleeve.motif, state.progress.sleeve.palette
+        self:renderSleeve()
+    end
+    enable(self.sleeveSave, state.activities.sleeve_studio.nearby)
+    self.sleeveSave.Text = if state.activities.sleeve_studio.nearby
+        then "Print and keep this sleeve"
+        else "Visit Needle Records to print"
+    local identity = state.identity
+    self.rank.Text = identity.rank.label .. "  /  " .. identity.titleLabel
+    local tracks = {}
+    for _, track in identity.tracks do
+        table.insert(
+            tracks,
+            track.label
+                .. "  ·  "
+                .. track.levelLabel
+                .. "  ·  "
+                .. track.xp
+                .. " XP"
+                .. (
+                    if track.nextAt
+                        then " / " .. track.nextAt .. " to next level"
+                        else " / Demo mastery"
+                )
+        )
+    end
+    self.tracks.Text = table.concat(tracks, "\n")
+    for index, title in identity.titles do
+        if not self.titleButtons[title.id] then
+            self.titleButtons[title.id] = button(self.titles, title.label, function()
+                self.send("LifeTitle", title.id)
+            end, index)
+        end
+        local control = self.titleButtons[title.id]
+        control.Text = title.label
+            .. (
+                if identity.title == title.id
+                    then "  /  Selected"
+                    elseif not title.owned then "  /  Keep exploring"
+                    else ""
+            )
+        enable(control, title.owned)
+    end
+    for _, look in identity.outfits do
+        self.lookButtons[look.index].save.Text = (
+            if look.saved then "Replace look " else "Save look "
+        ) .. look.index
+        enable(self.lookButtons[look.index].load, look.saved)
+    end
+    self:renderItems()
+end
+
+function Panel:destroy()
+    self.preview:destroy()
+    self.explore:Destroy()
+    self.style:Destroy()
+end
+
+return Panel
diff --git a/src/client/QuayWardrobePreview.luau b/src/client/QuayWardrobePreview.luau
new file mode 100644
index 0000000..d764c47
--- /dev/null
+++ b/src/client/QuayWardrobePreview.luau
@@ -0,0 +1,408 @@
+-- A mirror of the player's currently worn avatar, never an unowned-item preview.
+-- Camera-only rotation, no animation loop, and no WorldModel while hidden.
+-- Sources checked 2026-10-30:
+-- https://create.roblox.com/docs/ui/viewport-frames
+-- https://create.roblox.com/docs/reference/engine/classes/WorldModel
+-- https://create.roblox.com/docs/reference/engine/classes/Player
+local Players = game:GetService("Players")
+local Theme = require(game:GetService("ReplicatedStorage").Shared.Theme)
+local Gui = require(script.Parent.GuiFactory)
+local Preview = {}
+Preview.__index = Preview
+
+local MAX_DESCENDANTS = 1000 -- Local preview budget, not a Roblox platform limit.
+local DEBOUNCE = 0.15
+
+local function disconnectAll(connections)
+    for _, connection in connections do
+        connection:Disconnect()
+    end
+    table.clear(connections)
+end
+
+local function visualObject(object)
+    return object:IsA("Model")
+        or object:IsA("Folder")
+        or object:IsA("Accoutrement")
+        or object:IsA("BasePart")
+        or object:IsA("DataModelMesh")
+        or object:IsA("Decal")
+        or object:IsA("SurfaceAppearance")
+        or object:IsA("Clothing")
+        or object:IsA("ShirtGraphic")
+        or object:IsA("BodyColors")
+        or object:IsA("CharacterMesh")
+        or object:IsA("Humanoid")
+        or object:IsA("Attachment")
+        or object:IsA("WrapLayer")
+        or object:IsA("WrapTarget")
+        or object:IsA("JointInstance")
+        or object:IsA("WeldConstraint")
+        or object:IsA("FaceControls")
+end
+
+local function appearanceProperties(object)
+    if object:IsA("MeshPart") then
+        return { "Size", "Color", "Transparency", "Material", "MeshId", "TextureID" }
+    elseif object:IsA("BasePart") then
+        return { "Size", "Color", "Transparency", "Material" }
+    elseif object:IsA("SpecialMesh") then
+        return { "MeshId", "TextureId", "Scale", "Offset" }
+    elseif object:IsA("Shirt") then
+        return { "ShirtTemplate" }
+    elseif object:IsA("Pants") then
+        return { "PantsTemplate" }
+    elseif object:IsA("ShirtGraphic") then
+        return { "Graphic" }
+    elseif object:IsA("Decal") then
+        return { "Texture", "Color3", "Transparency" }
+    elseif object:IsA("BodyColors") then
+        return {
+            "HeadColor3",
+            "LeftArmColor3",
+            "RightArmColor3",
+            "LeftLegColor3",
+            "RightLegColor3",
+            "TorsoColor3",
+        }
+    elseif object:IsA("CharacterMesh") then
+        return { "BodyPart", "MeshId", "BaseTextureId", "OverlayTextureId" }
+    elseif object:IsA("SurfaceAppearance") then
+        return { "ColorMap", "NormalMap", "MetalnessMap", "RoughnessMap" }
+    end
+    return {}
+end
+
+local function copyCharacter(character)
+    if #character:GetDescendants() > MAX_DESCENDANTS then
+        return nil,
+            "This avatar is too detailed for the small mirror. Your equipped look is unchanged."
+    end
+    local originalArchivable = character.Archivable
+    local ok, clone = pcall(function()
+        character.Archivable = true
+        return character:Clone()
+    end)
+    -- No yield occurs between changing and restoring the source flag.
+    character.Archivable = originalArchivable
+    if not ok or not clone then
+        return nil, "Your avatar is still arriving. Open My style again in a moment."
+    end
+    clone.Name = "WornAvatarPreview"
+    local parts = 0
+    for _, object in clone:GetDescendants() do
+        if not object:IsDescendantOf(clone) then
+            continue
+        end
+        -- The visual allowlist removes scripts, tools, audio, particles, lights,
+        -- interaction objects and UI before the clone receives any parent.
+        if object:IsA("Tool") or not visualObject(object) then
+            object:Destroy()
+        elseif object:IsA("BasePart") then
+            object.Anchored = true
+            object.CanCollide = false
+            object.CanTouch = false
+            object.CanQuery = false
+            object.CastShadow = false
+            object.LocalTransparencyModifier = 0
+            parts += 1
+        elseif object:IsA("Humanoid") then
+            object.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
+            object.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
+            object.AutoRotate = false
+            object.BreakJointsOnDeath = false
+        elseif object:IsA("JointInstance") or object:IsA("WeldConstraint") then
+            if
+                (object.Part0 and not object.Part0:IsDescendantOf(clone))
+                or (object.Part1 and not object.Part1:IsDescendantOf(clone))
+            then
+                object:Destroy()
+            end
+        end
+    end
+    if parts == 0 then
+        clone:Destroy()
+        return nil, "Your avatar is still arriving. Open My style again in a moment."
+    end
+    clone:PivotTo(CFrame.new())
+    return clone
+end
+
+function Preview.new(parent)
+    local self = setmetatable({
+        visible = false,
+        destroyed = false,
+        yaw = 0,
+        generation = 0,
+        connections = {},
+        characterConnections = {},
+        objectConnections = {},
+        watchedObjects = 0,
+    }, Preview)
+    self.root = Gui.make("Frame", parent, {
+        Name = "WardrobeMirror",
+        BackgroundTransparency = 1,
+        Size = UDim2.new(1, 0, 0, 272),
+        Visible = false,
+    })
+    self.viewport = Gui.round(
+        Gui.make("ViewportFrame", self.root, {
+            Name = "YourWornAvatar",
+            Size = UDim2.new(1, 0, 0, 220),
+            BackgroundColor3 = Theme.Stone,
+            BorderSizePixel = 0,
+            Ambient = Color3.fromRGB(190, 184, 172),
+            LightColor = Color3.fromRGB(245, 234, 212),
+            LightDirection = Vector3.new(-1, -1, -2),
+        }),
+        8
+    )
+    self.status = Gui.label(self.root, "Your wardrobe mirror", 14, Theme.Ink)
+    self.status.Position = UDim2.fromOffset(12, 12)
+    self.status.Size = UDim2.new(1, -24, 0, 56)
+    self.status.TextYAlignment = Enum.TextYAlignment.Top
+    self.status.ZIndex = 2
+    self.left = Gui.button(self.root, "Rotate left", function()
+        if self.visible and not self.destroyed then
+            self.yaw -= math.pi / 6
+            self:_frameCamera()
+        end
+    end)
+    self.right = Gui.button(self.root, "Rotate right", function()
+        if self.visible and not self.destroyed then
+            self.yaw += math.pi / 6
+            self:_frameCamera()
+        end
+    end)
+    self.left.Position, self.left.Size = UDim2.fromOffset(0, 228), UDim2.new(0.5, -4, 0, 44)
+    self.right.Position, self.right.Size = UDim2.new(0.5, 4, 0, 228), UDim2.new(0.5, -4, 0, 44)
+    table.insert(
+        self.connections,
+        self.viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
+            self:_frameCamera()
+        end)
+    )
+    local player = Players.LocalPlayer
+    table.insert(
+        self.connections,
+        player.CharacterAdded:Connect(function(character)
+            self:_bindCharacter(character)
+            self:refresh()
+        end)
+    )
+    table.insert(
+        self.connections,
+        player.CharacterRemoving:Connect(function(character)
+            if self.character == character then
+                self:_bindCharacter(nil)
+                self:_cancelRefresh()
+                self:_clearWorld()
+                self.status.Text = "Your avatar is arriving..."
+                self.status.Visible = true
+            end
+        end)
+    )
+    -- CharacterAppearanceLoaded is server-only. Replicated appearance arrives
+    -- through the character descendants/property observers below on this client.
+    table.insert(
+        self.connections,
+        self.root.Destroying:Connect(function()
+            self:destroy(true)
+        end)
+    )
+    self:_bindCharacter(player.Character)
+    return self
+end
+
+function Preview:_watch(object)
+    if
+        self.objectConnections[object]
+        or self.overBudget
+        or self.watchedObjects >= MAX_DESCENDANTS
+    then
+        return
+    end
+    local connections = {}
+    for _, property in appearanceProperties(object) do
+        table.insert(
+            connections,
+            object:GetPropertyChangedSignal(property):Connect(function()
+                self:refresh()
+            end)
+        )
+    end
+    if #connections > 0 then
+        self.objectConnections[object] = connections
+        self.watchedObjects += 1
+    end
+end
+
+function Preview:_bindCharacter(character)
+    disconnectAll(self.characterConnections)
+    for _, connections in self.objectConnections do
+        disconnectAll(connections)
+    end
+    table.clear(self.objectConnections)
+    self.watchedObjects = 0
+    self.overBudget = false
+    self.character = character
+    if not character then
+        return
+    end
+    local descendants = character:GetDescendants()
+    self.overBudget = #descendants > MAX_DESCENDANTS
+    if not self.overBudget then
+        for _, object in descendants do
+            self:_watch(object)
+        end
+    end
+    table.insert(
+        self.characterConnections,
+        character.DescendantAdded:Connect(function(object)
+            self:_watch(object)
+            if visualObject(object) then
+                self:refresh()
+            end
+        end)
+    )
+    table.insert(
+        self.characterConnections,
+        character.DescendantRemoving:Connect(function(object)
+            local connections = self.objectConnections[object]
+            if connections then
+                disconnectAll(connections)
+                self.objectConnections[object] = nil
+                self.watchedObjects -= 1
+            end
+            if visualObject(object) then
+                self:refresh()
+            end
+        end)
+    )
+end
+
+function Preview:_cancelRefresh()
+    self.generation += 1
+    if self.pending then
+        task.cancel(self.pending)
+        self.pending = nil
+    end
+end
+
+function Preview:_clearWorld()
+    self.viewport.CurrentCamera = nil
+    if self.world then
+        self.world:Destroy()
+        self.world = nil
+    end
+    if self.camera then
+        self.camera:Destroy()
+        self.camera = nil
+    end
+    self.bounds = nil
+end
+
+function Preview:_frameCamera()
+    if self.destroyed or not self.visible or not self.camera or not self.bounds then
+        return
+    end
+    local frameSize = self.viewport.AbsoluteSize
+    if frameSize.X < 1 or frameSize.Y < 1 then
+        return
+    end
+    -- Viewport cameras do not inherit the gameplay camera's viewport dimensions.
+    local halfVertical = math.rad(self.camera.FieldOfView) / 2
+    local halfHorizontal = math.atan(math.tan(halfVertical) * frameSize.X / frameSize.Y)
+    local radius = math.max(1, self.bounds.size.Magnitude * 0.5)
+    local distance = radius / math.sin(math.min(halfVertical, halfHorizontal)) * 1.08
+    local target = self.bounds.center
+    local position = target + Vector3.new(math.sin(self.yaw), 0, -math.cos(self.yaw)) * distance
+    self.camera.CFrame = CFrame.lookAt(position, target)
+    self.camera.Focus = CFrame.new(target)
+end
+
+function Preview:_rebuild()
+    if self.destroyed or not self.visible then
+        return
+    end
+    local character = Players.LocalPlayer.Character
+    self:_clearWorld()
+    if not character or not character.Parent then
+        self.status.Text = "Your avatar is arriving..."
+        self.status.Visible = true
+        return
+    end
+    if self.overBudget and #character:GetDescendants() <= MAX_DESCENDANTS then
+        self:_bindCharacter(character)
+    end
+    local clone, message = copyCharacter(character)
+    if not clone then
+        self.status.Text = message
+        self.status.Visible = true
+        return
+    end
+    self.world = Instance.new("WorldModel")
+    self.world.Name = "WardrobeMirrorWorld"
+    self.world.Parent = self.viewport
+    clone.Parent = self.world
+    self.camera = Instance.new("Camera")
+    self.camera.Name = "WardrobeMirrorCamera"
+    self.camera.CameraType = Enum.CameraType.Scriptable
+    self.camera.FieldOfView = 35
+    self.camera.Parent = self.viewport
+    self.viewport.CurrentCamera = self.camera
+    local frame, size = clone:GetBoundingBox()
+    self.bounds = { center = frame.Position, size = size }
+    self.status.Visible = false
+    self:_frameCamera()
+end
+
+function Preview:refresh()
+    if self.destroyed or not self.visible then
+        return
+    end
+    self:_cancelRefresh()
+    local generation = self.generation
+    self.pending = task.delay(DEBOUNCE, function()
+        self.pending = nil
+        if self.destroyed or not self.visible or generation ~= self.generation then
+            return
+        end
+        self:_rebuild()
+    end)
+end
+
+function Preview:setVisible(visible)
+    if self.destroyed or self.visible == (visible == true) then
+        return
+    end
+    self.visible = visible == true
+    self.root.Visible = self.visible
+    if self.visible then
+        self.status.Text = "Your wardrobe mirror is loading..."
+        self.status.Visible = true
+        if self.character ~= Players.LocalPlayer.Character then
+            self:_bindCharacter(Players.LocalPlayer.Character)
+        end
+        self:refresh()
+    else
+        self:_cancelRefresh()
+        self:_clearWorld()
+    end
+end
+
+function Preview:destroy(fromRoot)
+    if self.destroyed then
+        return
+    end
+    self.destroyed = true
+    self:_cancelRefresh()
+    disconnectAll(self.connections)
+    self:_bindCharacter(nil)
+    self:_clearWorld()
+    if not fromRoot then
+        self.root:Destroy()
+    end
+end
+
+return Preview
diff --git a/src/client/QuayShopPanel.luau b/src/client/QuayShopPanel.luau
new file mode 100644
index 0000000..78a6682
--- /dev/null
+++ b/src/client/QuayShopPanel.luau
@@ -0,0 +1,344 @@
+local MarketplaceService = game:GetService("MarketplaceService")
+local Players = game:GetService("Players")
+local Shared = game:GetService("ReplicatedStorage").Shared
+local Catalog = require(Shared.CommerceCatalog)
+local Theme = require(Shared.Theme)
+local Gui = require(script.Parent.GuiFactory)
+
+local Shop = {}
+Shop.__index = Shop
+
+local function label(parent, name, text, size, order)
+    local object = Gui.label(parent, text, size)
+    object.Name = name
+    object.Size = UDim2.new(1, 0, 0, size + 4)
+    object.AutomaticSize = Enum.AutomaticSize.Y
+    object.LayoutOrder = order
+    object.TextYAlignment = Enum.TextYAlignment.Top
+    return object
+end
+
+local function setButton(button, text, enabled)
+    button.Text = text
+    button.Active = enabled
+    button.Selectable = enabled
+    button.AutoButtonColor = enabled
+    button.TextTransparency = if enabled then 0 else 0.28
+    button.BackgroundColor3 = if enabled then Theme.Teal else Theme.Graphite
+end
+
+function Shop.new(parent, refreshOwnership)
+    local self = setmetatable({
+        cards = {},
+        state = nil,
+        prompt = nil,
+        refreshOwnership = refreshOwnership,
+        destroyed = false,
+    }, Shop)
+    self.frame = Gui.make("Frame", parent, {
+        Name = "NeedleQuayShop",
+        Size = UDim2.new(1, -6, 0, 0),
+        AutomaticSize = Enum.AutomaticSize.Y,
+        BackgroundTransparency = 1,
+        LayoutOrder = 1,
+    })
+    Gui.make("UIListLayout", self.frame, {
+        Padding = UDim.new(0, 12),
+        SortOrder = Enum.SortOrder.LayoutOrder,
+    })
+    local heading = label(self.frame, "Heading", "THE QUAY STYLE COUNTER", 18, 1)
+    heading.Font = Theme.Bold
+    label(
+        self.frame,
+        "Introduction",
+        "Find your own look. Every set is permanent and cosmetic, for use in BeatMakka. Earn more styles by exploring the Quay.",
+        14,
+        2
+    )
+    self.status = label(self.frame, "ShopStatus", "Checking the counter...", 14, 3)
+    for index, bundleId in Catalog.Order do
+        local bundle = Catalog.Bundles[bundleId]
+        local card = Gui.round(Gui.make("Frame", self.frame, {
+            Name = "Bundle_" .. bundleId,
+            Size = UDim2.new(1, 0, 0, 0),
+            AutomaticSize = Enum.AutomaticSize.Y,
+            BackgroundColor3 = Theme.Stone,
+            BorderSizePixel = 0,
+            LayoutOrder = index + 3,
+        }))
+        Gui.make("UIPadding", card, {
+            PaddingLeft = UDim.new(0, 12),
+            PaddingRight = UDim.new(0, 12),
+            PaddingTop = UDim.new(0, 12),
+            PaddingBottom = UDim.new(0, 12),
+        })
+        Gui.make("UIListLayout", card, {
+            Padding = UDim.new(0, 8),
+            SortOrder = Enum.SortOrder.LayoutOrder,
+        })
+        local title = label(card, "Title", bundle.label, 17, 1)
+        title.Font = Theme.Bold
+        label(card, "Description", bundle.description, 14, 2)
+        label(
+            card,
+            "Contents",
+            "Includes: " .. table.concat(Catalog.contents(bundleId), ", ") .. ".",
+            13,
+            3
+        )
+        local status = label(card, "Status", "Not on sale.", 13, 4)
+        local buy = Gui.button(card, "Not on sale", function()
+            self:_buy(bundleId)
+        end)
+        buy.Name = "BuyBundle"
+        buy.Size = UDim2.new(1, 0, 0, 44)
+        buy.LayoutOrder = 5
+        local retry = Gui.button(card, "Check price again", function()
+            if self.cards[bundleId].retryMode == "ownership" then
+                self:_retryOwnership(bundleId)
+            else
+                self:_fetchPrice(bundleId, true)
+            end
+        end)
+        retry.Name = "RetryPrice"
+        retry.Size = UDim2.new(1, 0, 0, 44)
+        retry.LayoutOrder = 6
+        retry.Visible = false
+        self.cards[bundleId] = {
+            frame = card,
+            status = status,
+            buy = buy,
+            retry = retry,
+            priceState = "idle",
+            price = nil,
+            priceAt = 0,
+            priceToken = 0,
+            notice = nil,
+            verifying = false,
+            nextOwnershipRetry = 0,
+        }
+    end
+    self.purchaseConnection = MarketplaceService.PromptGamePassPurchaseFinished:Connect(
+        function(player, passId, wasPurchased)
+            local pending = self.prompt
+            if
+                self.destroyed
+                or player ~= Players.LocalPlayer
+                or not pending
+                or pending.passId ~= passId
+            then
+                return
+            end
+            self.prompt = nil
+            local card = self.cards[pending.bundleId]
+            if wasPurchased then
+                card.verifying = true
+                card.notice =
+                    "Checking ownership. Your items appear in Wardrobe after verification."
+            else
+                card.verifying = false
+                card.notice = "Purchase cancelled. Your current look stays the same."
+            end
+            -- Only a later server summary can mark this bundle owned.
+            self:_render()
+        end
+    )
+    self.destroyConnection = self.frame.Destroying:Connect(function()
+        self:destroy(true)
+    end)
+    self:_render()
+    return self
+end
+
+function Shop:_available(bundleId)
+    local state = self.state
+    local entry = state and state.bundles and state.bundles[bundleId]
+    return state ~= nil
+        and state.enabled == true
+        and Catalog.Enabled == true
+        and Catalog.bindingReady(bundleId)
+        and entry ~= nil
+        and entry.available == true
+        and not (state.owned and state.owned[bundleId] == true)
+end
+
+function Shop:_retryOwnership(bundleId)
+    local card = self.cards[bundleId]
+    if self.destroyed or not self.refreshOwnership or os.clock() < card.nextOwnershipRetry then
+        return
+    end
+    card.nextOwnershipRetry = os.clock() + 5
+    -- A retry requests server evidence; it must never reopen a purchase window.
+    self.refreshOwnership()
+end
+
+function Shop:_fetchPrice(bundleId, force)
+    local card = self.cards[bundleId]
+    if
+        self.destroyed
+        or not card
+        or card.verifying
+        or not self:_available(bundleId)
+        or card.priceState == "loading"
+    then
+        return
+    end
+    if not force and card.priceState ~= "idle" then
+        return
+    end
+    card.priceToken += 1
+    local token = card.priceToken
+    card.priceState = "loading"
+    card.price = nil
+    self:_render()
+    task.spawn(function()
+        local ok, info = pcall(function()
+            return MarketplaceService:GetProductInfoAsync(
+                Catalog.Bundles[bundleId].PassId,
+                Enum.InfoType.GamePass
+            )
+        end)
+        if self.destroyed or card.priceToken ~= token then
+            return
+        end
+        local price = if ok and type(info) == "table" then info.PriceInRobux else nil
+        if ok and type(info) == "table" and info.IsForSale ~= true then
+            card.priceState = "unavailable"
+        elseif type(price) == "number" and price > 0 and price < 2 ^ 53 and price % 1 == 0 then
+            card.price = price
+            card.priceAt = os.clock()
+            card.priceState = "ready"
+        else
+            card.priceState = "error"
+        end
+        self:_render()
+    end)
+end
+
+function Shop:_buy(bundleId)
+    local card = self.cards[bundleId]
+    if self.destroyed or self.prompt or not self:_available(bundleId) or card.verifying then
+        return
+    end
+    if card.priceState ~= "ready" then
+        self:_fetchPrice(bundleId, true)
+        return
+    end
+    if os.clock() - card.priceAt > 60 then
+        card.notice = "Refreshing the price. Review it, then choose Buy when you are ready."
+        self:_fetchPrice(bundleId, true)
+        return
+    end
+    local passId = Catalog.Bundles[bundleId].PassId
+    self.prompt = { bundleId = bundleId, passId = passId }
+    card.notice = nil
+    self:_render()
+    local ok = pcall(function()
+        MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, passId)
+    end)
+    if not ok and not self.destroyed then
+        self.prompt = nil
+        card.notice = "The purchase window could not open. You can try again when ready."
+        self:_render()
+    end
+end
+
+function Shop:_render()
+    if self.destroyed then
+        return
+    end
+    local state = self.state
+    self.status.Text = if not state
+        then "Checking the counter..."
+        elseif
+            state.enabled ~= true
+        then "These sets are being prepared. The full Needle Quay adventure is available through play."
+        else "Optional style sets. The price below comes from Roblox for your account; the Roblox window confirms your purchase."
+    for _, bundleId in Catalog.Order do
+        local card = self.cards[bundleId]
+        local entry = state and state.bundles and state.bundles[bundleId]
+        local owned = state and state.owned and state.owned[bundleId] == true
+        card.retry.Visible = false
+        card.retryMode = "price"
+        card.retry.Text = "Check price again"
+        if owned then
+            card.verifying = false
+            card.notice = nil
+            card.status.Text = "Yours permanently in BeatMakka. Choose these items in Wardrobe."
+            setButton(card.buy, "Owned", false)
+        elseif not state or (entry and entry.status == "checking") then
+            card.status.Text = "Checking your owned styles..."
+            setButton(card.buy, "Checking ownership", false)
+        elseif entry and entry.status == "error" then
+            card.status.Text =
+                "Ownership could not be confirmed. Check again, or rejoin to restore completed purchases."
+            setButton(card.buy, "Ownership unavailable", false)
+            card.retryMode = "ownership"
+            card.retry.Text = "Check ownership again"
+            card.retry.Visible = self.refreshOwnership ~= nil
+        elseif not self:_available(bundleId) then
+            card.status.Text = "This style set is being prepared and is not on sale."
+            setButton(card.buy, "Not on sale", false)
+        elseif self.prompt then
+            card.status.Text = "Finish or close the Roblox purchase window to continue."
+            setButton(
+                card.buy,
+                if self.prompt.bundleId == bundleId
+                    then "Purchase window open"
+                    else "Purchase in progress",
+                false
+            )
+        elseif card.verifying then
+            card.status.Text =
+                "Roblox has not confirmed ownership yet. Check again, or rejoin to restore your items. No second purchase window will open."
+            setButton(card.buy, "Checking purchase", false)
+            card.retryMode = "ownership"
+            card.retry.Text = "Check ownership again"
+            card.retry.Visible = self.refreshOwnership ~= nil
+        elseif card.priceState == "error" then
+            card.status.Text = "The current price could not be loaded. No purchase has been opened."
+            setButton(card.buy, "Price unavailable", false)
+            card.retry.Visible = true
+        elseif card.priceState == "unavailable" then
+            card.status.Text = "This set is not currently for sale on Roblox."
+            setButton(card.buy, "Not on sale", false)
+            card.retry.Visible = true
+        elseif card.priceState == "ready" then
+            card.status.Text = card.notice
+                or "Three guaranteed cosmetic items. No effect on music tools, XP or story progress."
+            setButton(card.buy, "Buy for " .. tostring(card.price) .. " Robux", true)
+        else
+            card.status.Text = "Loading the current price for your account..."
+            setButton(card.buy, "Loading price", false)
+        end
+    end
+end
+
+function Shop:update(commerceSummary)
+    if self.destroyed then
+        return
+    end
+    self.state = commerceSummary
+    self:_render()
+    for _, bundleId in Catalog.Order do
+        self:_fetchPrice(bundleId, false)
+    end
+end
+
+function Shop:destroy(parentDestroying)
+    if self.destroyed then
+        return
+    end
+    self.destroyed = true
+    if self.purchaseConnection then
+        self.purchaseConnection:Disconnect()
+    end
+    if self.destroyConnection then
+        self.destroyConnection:Disconnect()
+    end
+    if not parentDestroying then
+        self.frame:Destroy()
+    end
+end
+
+return Shop
